# Next.js & Convex Client
NEXT_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Convex Deployment Secrets (set via `npx convex env set <KEY> <VALUE>`)
# CLERK_JWT_ISSUER_DOMAIN=https://<your-app>.clerk.accounts.dev
# N8N_WEBHOOK_URL=https://<your-public-n8n>/webhook/lendloop-loan-events
# N8N_WEBHOOK_SECRET=<hex-32>
# AUTOMATION_API_KEY=<hex-32>

# Local n8n Container Environment (.env)
N8N_ENCRYPTION_KEY=
LENDLOOP_WEBHOOK_SECRET=
CONVEX_SITE_URL=https://<deployment>.convex.site
N8N_PUBLIC_URL=
TZ=Africa/Lagos
