{
  "name": "LendLoop · Loan events",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lendloop-loan-events",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "id": "11111111-0000-0000-0000-000000000001"
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nconst item = $input.first();\nconst headers = item.json.headers || {};\nconst ts = headers['x-lendloop-timestamp'];\nconst sig = headers['x-lendloop-signature'] || '';\n\nconst raw = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst body = raw.toString('utf8');\n\nconst secret = $vars.LENDLOOP_WEBHOOK_SECRET || '';\nconst fresh = ts && Math.abs(Date.now() - Number(ts)) < 5 * 60 * 1000;\nconst expected = crypto.createHmac('sha256', secret)\n  .update(`${ts}.${body}`).digest('hex');\n\nconst a = Buffer.from(sig, 'hex');\nconst b = Buffer.from(expected, 'hex');\nconst valid = Boolean(fresh) && a.length === b.length && crypto.timingSafeEqual(a, b);\n\nreturn [{ json: { valid, payload: valid ? JSON.parse(body) : null } }];"
      },
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300],
      "id": "11111111-0000-0000-0000-000000000002"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.valid }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Is valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300],
      "id": "11111111-0000-0000-0000-000000000003"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"ok\": false, \"error\": \"Invalid or expired signature\"}",
        "options": {
          "responseCode": 401
        }
      },
      "name": "Respond 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [900, 420],
      "id": "11111111-0000-0000-0000-000000000004"
    },
    {
      "parameters": {
        "jsCode": "const p = $json.payload;\nconst when = `${p.startDate} → ${p.endDate}`;\nconst copy = {\n  request_created:  [`New request: ${p.toolName}`,        `${p.counterpartName} would like to borrow it (${when}).`],\n  request_approved: [`Approved: ${p.toolName}`,           `${p.counterpartName} approved your request (${when}).`],\n  request_declined: [`Declined: ${p.toolName}`,           `${p.counterpartName} can't lend it this time.`],\n  loan_returned:    [`Returned: ${p.toolName}`,           `${p.counterpartName} marked it as returned. Thanks!`],\n}[p.event];\n\nif (!copy) throw new Error(`Unknown event: ${p.event}`);\nreturn [{ json: { to: p.recipient.email, subject: copy[0], text: `Hi ${p.recipient.name},\\n\\n${copy[1]}\\n\\n- LendLoop` } }];"
      },
      "name": "Compose message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 200],
      "id": "11111111-0000-0000-0000-000000000005"
    },
    {
      "parameters": {
        "fromEmail": "LendLoop <noreply@lendloop.local>",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}"
      },
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1120, 200],
      "id": "11111111-0000-0000-0000-000000000006",
      "credentials": {
        "smtp": {
          "id": "1",
          "name": "Mailpit SMTP"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"ok\": true}",
        "options": {
          "responseCode": 200
        }
      },
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1340, 200],
      "id": "11111111-0000-0000-0000-000000000007"
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
